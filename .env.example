# Programming engine – copy to .env at repo root and fill in. Do not commit .env.

# Supabase (required for tools: apply_auto_exclusions, future fetch/normalize/generate/write)
SUPABASE_URL=https://your-project.supabase.co
# Prefer service role for server-side tools (e.g. auto-exclusions); anon key works for read-only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key

# Supabase Management API (for schema_reference / lockeroom_schema diagram auto-update)
# Personal access token from https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token

# Regeneration API (Railway deployment)
# Shared secret used by the frontend to authenticate to the Railway API
API_SECRET=your-api-secret
# Comma-separated allowed CORS origins (defaults to localhost if unset)
# CORS_ORIGINS=http://localhost:5180,https://your-frontend.vercel.app
