# Programming engine – copy to .env at repo root and fill in. Do not commit .env.

# Supabase (required for tools: apply_auto_exclusions, future fetch/normalize/generate/write)
SUPABASE_URL=https://your-project.supabase.co
# Prefer service role for server-side tools (e.g. auto-exclusions); anon key works for read-only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key
